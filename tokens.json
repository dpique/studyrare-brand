  "motif": {
    "name": "dot-motif",
    "description": "Periwinkle dot field with exactly one amber dot. The amber dot is the rare signal. Never two amber dots, never all-amber field.",
    "fieldColor":  "#8893e5",
    "signalColor": "#e8a838",
    "backgroundDark":  "#1a2035",
    "backgroundLight": "#faf8f4",
    "dotSizeMinPx": 4,
    "dotSizeMaxPx": 20,
    "typicalDotCount": [8, 14],
    "signalDotCount": 1,
    "signalPositionDefault": "upper-right"
  },
  "typography": {
    "fontFamily": {
      "serif": "Source Serif 4, Georgia, serif",
      "sans":  "Inter, system-ui, -apple-system, sans-serif",
      "mono":  "Geist Mono, ui-monospace, monospace"
    },
    "fontSize": {
      "xs":   "0.75rem",
      "sm":   "0.875rem",
      "base": "1rem",
      "lg":   "1.125rem",
      "xl":   "1.25rem",
      "2xl":  "1.5rem",
      "3xl":  "1.875rem",
      "4xl":  "2.25rem",
      "5xl":  "3rem"
    },
    "fontWeight": {
      "normal":   400,
      "medium":   500,
      "semibold": 600,
      "bold":     700
    },
    "lineHeight": {
      "tight":   1.25,
      "normal":  1.5,
      "relaxed": 1.7
    },
    "headingFont": "Source Serif 4",
    "bodyFont":    "Inter"
  },
  "spacing": {
    "borderRadius":      "0.625rem",
    "borderRadiusSm":    "0.375rem",
