    "borderRadiusXl":    "1rem",
    "containerMaxWidth": "72rem",
    "contentMaxWidth":   "48rem",
    "sectionPaddingY":   "5rem",
    "sectionPaddingX":   "1.5rem"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.05)",
    "md": "0 2px 8px rgba(0,0,0,0.08)",
    "lg": "0 4px 16px rgba(0,0,0,0.10)"
  },
  "motion": {
    "durationFast":   "100ms",
    "durationNormal": "200ms",
    "durationSlow":   "300ms",
    "easing":         "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "logo": {
    "file":                "logo.png",
    "textPrimary":         "StudyRare",
    "twoToneAllowed":      "lockup-only",
    "plainTextColorOnLight": "#1a2035",
    "plainTextColorOnDark":  "#ffffff",
    "accentColor":         "#e8a838"
